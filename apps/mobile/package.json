{
  "name": "volume-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "start:lan": "powershell -ExecutionPolicy Bypass -File scripts/start-lan.ps1",
    "build:dev:android": "npx eas-cli build --profile development --platform android",
    "build:dev:ios": "npx eas-cli build --profile development --platform ios",
    "start:tunnel": "powershell -ExecutionPolicy Bypass -File scripts/start-lan.ps1 -Tunnel"
  },
  "dependencies": {
    "expo": "^58.0.24",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.19",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eas-cli": "^27.9.0",
    "typescript": "~6.0.3"
  }
}
